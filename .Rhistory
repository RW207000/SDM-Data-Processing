totaldailyformedswide <- select(medperpatient, c("Assessment.ID", "total_daily_HCeq_dose"))
meds_wide <- meds_wide %>%
left_join(select(medperpatient, Assessment.ID, total_daily_HCeq_dose), by = "Assessment.ID")
meds_wide <- meds_wide %>%
select_if(function(x) !all(is.na(x)))
# let's add in the number of doses per patient
doses_per_patient <- select(medication_clean, c("coid_assedate", "assessment_entry"))
doses_per_patient_2 <- doses_per_patient %>%
group_by(coid_assedate) %>%
summarise("number of doses" = max(assessment_entry))
meds_wide <- left_join(meds_wide, doses_per_patient_2, by = c("coid_assedate_1" = "coid_assedate"))
remove(totalmed_1st_entry, totalmed_2nd_entry, totalmed_3rd_entry, totalmed_4th_entry, totalmed_5th_entry, totalmed_6th_entry)
# drop unnecessary columns from meds_wide (e.g.: duplicated 'coid_asse_date')
# meds_wide <- meds_wide[-c(12, 19, 20, 22, 29, 30, 32, 37, 38)]
meds_wide$`therapy type` <- "single or combined"
meds_wide$`therapy type` <-
ifelse(!is.na(meds_wide$Medicine_1) &
(is.na(meds_wide$Medicine_2) & is.na(meds_wide$Medicine_3) & is.na(meds_wide$Medicine_4) |
meds_wide$Medicine_1 == meds_wide$Medicine_2 & is.na(meds_wide$Medicine_3) & is.na(meds_wide$Medicine_4) |
meds_wide$Medicine_1 == meds_wide$Medicine_2 & meds_wide$Medicine_1 == meds_wide$Medicine_3 & is.na(meds_wide$Medicine_4) |
meds_wide$Medicine_1 == meds_wide$Medicine_2 & meds_wide$Medicine_1 == meds_wide$Medicine_3 & meds_wide$Medicine_1 == meds_wide$Medicine_4),
as.character("single"),
as.character("combined"))
valuesdrop <- c("Result", "Time")
labsvalues <- labs[, !names(labs) %in% valuesdrop]
labsvalues <- labsvalues %>%
pivot_wider(names_from = "Type",
values_from = "Value")
interpdrop <- c("Value", "Time")
labsinterp <- labs[, !names(labs) %in% interpdrop]
labsinterp <- labsinterp %>%
pivot_wider(names_from = "Type",
values_from = "Result")
labs_wide <- left_join(labsvalues, labsinterp, by = c("CO.ID", "Assessment.ID", "Date"))
names(labs_wide) <- gsub(x = names(labs_wide), pattern = ".x",
replacement = ".value")
names(labs_wide) <- gsub(x = names(labs_wide), pattern = ".y",
replacement = ".interpretation")
# make unique identifier in labs_wide
labs_wide$coid_assedate <- paste(labs_wide$CO.ID, labs_wide$Date, sep = " ")
labs_wide_outputs <- removeDuplicates(labs_wide)
labs_wide <- labs_wide_outputs$noDupes
labs_wide_dupes = labs_wide_outputs$dupes
CAH_biomarkers <- select(labs_wide, c("Assessment.ID", "CO.ID", "Date", "17-OHP.value", "17-OHP.interpretation", "Androstenedione.value", "Androstenedione.interpretation", "Renin.value", "Renin.interpretation", "Total testosterone.value", "Total testosterone.interpretation", "Glucose.value", "Glucose.interpretation", "coid_assedate"))
# 17-OHP
CAH_biomarkers$`17-OHP.unit` <- str_extract(CAH_biomarkers$`17-OHP.value`, "[aA-zZ]+.?[aA-zZ]+.?[aA-zZ]*+")
CAH_biomarkers$`17-OHP.value` <- as.numeric(str_extract(CAH_biomarkers$`17-OHP.value`, "[0-9]+.?[0-9]*+"))
# androstenedione
CAH_biomarkers$`Androstenedione.unit` <- str_extract(CAH_biomarkers$`Androstenedione.value`, "[aA-zZ]+.?[aA-zZ]+.?[aA-zZ]*+")
CAH_biomarkers$`Androstenedione.value` <- as.numeric(str_extract(CAH_biomarkers$`Androstenedione.value`, "[0-9]+.?[0-9]*+"))
# testosterone
CAH_biomarkers$`Total.testosterone.unit` <- str_extract(CAH_biomarkers$`Total testosterone.value`, "[aA-zZ]+.?[aA-zZ]+.?[aA-zZ]*+")
CAH_biomarkers$`Total testosterone.value` <- as.numeric(str_extract(CAH_biomarkers$`Total testosterone.value`, "[0-9]+.?[0-9]*+"))
# renin
CAH_biomarkers$`Renin.unit` <- str_extract(CAH_biomarkers$`Renin.value`, "[aA-zZ]+.?[aA-zZ]+.?[aA-zZ]*+")
CAH_biomarkers$`Renin.value` <- as.numeric(str_extract(CAH_biomarkers$`Renin.value`, "[0-9]+.?[0-9]*+"))
CAH_biomarkers$Renin.plasma.activity <- (CAH_biomarkers$Renin.value * 0.158)
CAH_biomarkers$Renin.plasma.activity <- round(CAH_biomarkers$Renin.plasma.activity, digits = 2)
# glucose
CAH_biomarkers$Glucose.unit <- str_extract(CAH_biomarkers$Glucose.value, "[aA-zZ]+.?[aA-zZ]+.?[aA-zZ]*+")
CAH_biomarkers$Glucose.value <- as.numeric(str_extract(CAH_biomarkers$Glucose.value, "[0-9]+.?[0-9]*+"))
CAH_biomarkers_order <- c("Assessment.ID", "CO.ID", "Date", "coid_assedate", "17-OHP.value", "17-OHP.unit", "17-OHP.interpretation", "Androstenedione.value", "Androstenedione.unit", "Androstenedione.interpretation", "Renin.value", "Renin.unit", "Renin.interpretation", "Renin.plasma.activity", "Total testosterone.value", "Total.testosterone.unit", "Total testosterone.interpretation", "Glucose.value", "Glucose.interpretation")
CAH_biomarkers <- CAH_biomarkers[, CAH_biomarkers_order]
# some column types are 'list' which need to be converted to allow export later on
CAH_biomarkers$`17-OHP.interpretation` <- as.character(CAH_biomarkers$`17-OHP.interpretation`)
CAH_biomarkers$Androstenedione.interpretation <- as.character(CAH_biomarkers$Androstenedione.interpretation)
CAH_biomarkers$Renin.interpretation <- as.character(CAH_biomarkers$Renin.interpretation)
CAH_biomarkers$`Total testosterone.interpretation` <- as.character(CAH_biomarkers$Renin.interpretation)
CAH_biomarkers$Glucose.interpretation <- as.character(CAH_biomarkers$Glucose.interpretation)
meds_wide <- left_join(meds_wide, Centre.IDs, by = "CO.ID")
labs_wide <- left_join(labs_wide, Centre.IDs, by = "CO.ID")
# participantsnoduplicates (for sex and age distributions)
write.csv(participantsnoduplicates, file = "Data/3 Cleaned data/April 24 Extract (for Irina)/participantsnoduplicates.csv", row.names = F, na = "")
# medication_clean
write.csv(medication_clean, file = "Data/3 Cleaned data/April 24 Extract (for Irina)/medication_clean.csv", row.names = F, na = "")
# meds_wide
write.csv(meds_wide, file = "Data/3 Cleaned data/April 24 Extract (for Irina)/meds_wide.csv", row.names = F, na = "")
# CAH biomarkers
# CAH_biomarkers <- CAH_biomarkers[CAH_biomarkers$Date >= '2022-12-01',]
CAH_biomarkers_export <- apply(CAH_biomarkers,2,as.character)
write.csv(CAH_biomarkers_export, file = "Data/3 Cleaned data/April 24 Extract (for Irina)/CAH_biomarkers.csv", row.names = F, na = "")
labs_wide_export <- apply(labs_wide,2,as.character)
write.csv(labs_wide_export, file = "Data/3 Cleaned data/April 24 Extract (for Irina)/labs_wide.csv", row.names = F, na = "")
all_data <- left_join(participantsnoduplicates, CAH_biomarkers, by = "Assessment.ID")
all_data <- left_join(all_data, meds_wide, by = "Assessment.ID")
freqDF <- as.data.frame(freq(all_data$Assessment.ID))
freqDF_duplicates <- freqDF[freqDF$Freq >1,]
freqDF_duplicates <- rownames_to_column(freqDF_duplicates, var = "Assessment.ID")
duplicated_assessments <- freqDF_duplicates$Assessment.ID
all_data <- subset(all_data, !Assessment.ID %in% duplicated_assessments)
# write csv of all_data
write.csv(all_data, file = "Outputs/Dataframe outputs/April 24 Extract (for Irina)/all_data_ICAH_children_2025.csv", row.names = F, na = "")
print("Script complete")
