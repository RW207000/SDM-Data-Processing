hydro_and_pred_single_22_25 <- all_therapy_22_25_single[all_therapy_22_25_single$Medicine_1.x == "Hydrocortisone" | all_therapy_22_25_single$Medicine_1.x == "Prednisolone"]
##
hydro_and_pred_single_22_25 <- all_therapy_22_25_single[all_therapy_22_25_single$Medicine_1.x == "Hydrocortisone" & all_therapy_22_25_single$Medicine_1.x == "Prednisolone"]
test <- rbind(hydro_and_pred_single_22_25, all_therapy_22_25_combined)
test$grouping_med <- test$Medicine_1.x
test$grouping_med [test$`single/combined` == "combined"] <- "Combined"
test <- test[test$HC_equivalent_daily_dose_1_1 < 55, ]
HC_equiv_all_meds_22_25 <-
ggplot(test, aes(x = grouping_med, y = HC_equivalent_daily_dose_per_BSA, fill = grouping_med)) +
geom_violin() +
labs(title = "HCe", x = "Medicine", y = "HCe total daily dose (mg) per BSA") +
theme_classic() +
theme() +
geom_point(position = position_dodge(width = 0.75),
aes(group = grouping_med)) +
scale_y_continuous(breaks = seq(0, 35, by = 2.5))
HC_equiv_all_meds_22_25
