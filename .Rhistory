perBSA_therapy_dose_trends_all2 <- ggplot(single_therapy, aes(x = Centre.ID.x, y = HCe.total.daily.dose.per.BSA)) +
geom_violin() +
ggtitle("HC equivalent total daily dose per BSA (all data)") +
scale_y_continuous(breaks = seq(0, 35, by = 2.5)) +
theme_minimal() +
geom_point(position = position_dodge(width = 0), aes(shape = Medicine_1, color = Medicine_1)) +
scale_shape_manual(values=c(4, 19, 15, 17)) +
scale_color_manual(values = c("red", "dodgerblue", "gold", "green3")) +
annotate('rect', xmin=-Inf, xmax=Inf, ymin=10, ymax=15, alpha=.5, fill='grey') + geom_hline(yintercept = 11, colour = "red")
